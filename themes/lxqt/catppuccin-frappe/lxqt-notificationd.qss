Notification {
    color: #dee5f7;
    border: 0;
    background-color: #232634;
    border-radius: 0;
    font-family: "JetBrainsMonoNF-Regular", sans-serif;
    font-weight: normal;
}

QLabel {
    color: #dee5f7;
    background:transparent;
    border-radius: 0;
    border-bottom: none;
    
}

#bodyLabel{
    color: #dee5f7;
     padding: 0;
     border-radius: 0;
     border: 0; 
     margin: 0;
}

QVBoxLayout{
    border-radius: 0;
     border: 0;
}

#closeButton {
    border: none;
    qproperty-icon: url(lxqt-notificationd/cancel.svg);
    qproperty-icon-size: 24px;
}

#closeButton:hover {
    padding: 4px;
}

#appLabel {
    font-family: "JetBrainsMonoNF-Regular", sans-serif;
    font-size: 17px;
    font-weight: normal;
}

#summaryLabel {
    background: transparent;
    color: #dee5f7;
    border: none;
    font-weight: normal;
    font-family: "JetBrainsMonoNF-Regular", sans-serif;
}
