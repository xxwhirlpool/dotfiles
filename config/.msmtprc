defaults
auth on
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile ~/.config/msmtp/msmtp.log

account melodicake@disroot.org
host disroot.org
port 587
tls_starttls on
from melodicake@disroot.org
user melodicake@disroot.org
passwordeval "pass personal/melodicake_disroot"

account witnesslachesis@disroot.org
host disroot.org
port 587
tls_starttls on
from witnesslachesis@disroot.org
user witnesslachesis@disroot.org
passwordeval "pass personal/witnesslachesis"
