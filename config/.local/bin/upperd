#!/usr/bin/env bash
#
# usage:
#   - `echo "EXAMPLE" | upperd`
#   - `upperd "EXAMPLE"`
#   - `upperd -i`

default() {
	tr '[:lower:]' '[:upper:]' | perl -pe "chomp if eof" | tee >(xclip -selection clipboard)
}

takearg() {
	echo "$@" | default
}

stdinpaste() {
	gum write --header="paste text here" | tr '[:lower:]' '[:upper:]' | perl -pe "chomp if eof" | batcat --paging=never | tee >(xclip -selection clipboard)
}

case "$1" in
	"") default ;;
	"-i") stdinpaste ;;
	*) takearg "$@" ;;
esac
