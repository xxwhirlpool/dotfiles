#!/usr/bin/env bash
#
# usage:
#   - `echo "EXAMPLE" | upperd`
#   - `upperd "EXAMPLE"`
#   - `upperd -i`

default() {
	tr '[:lower:]' '[:upper:]' | tr -d "\n" | tee >(xclip -selection clipboard)
}

takearg() {
	echo "$@" | default
}

stdinpaste() {
	gum write --header="paste text here" | tr '[:lower:]' '[:upper:]' | tr -d "\n" | batcat --paging=never | tee >(xclip -selection clipboard)
}

case "$1" in
	"") default ;;
	"-i") stdinpaste && echo -e "\n" ;;
	*) takearg "$@" && echo -e "\n" ;;
esac
