#!/usr/bin/env bash
#
# usage:
#   - `echo "EXAMPLE" | lowerd`
#   - `lowerd "EXAMPLE"`
#   - `lowerd -i`

default() {
	tr '[:upper:]' '[:lower:]' | tr -d "\n" | tee >(xclip -selection clipboard)
}

takearg() {
	echo "$@" | default
}

stdinpaste() {
	gum write --header="paste text here" | tr '[:upper:]' '[:lower:]' | tr -d "\n" | batcat --paging=never | tee >(xclip -selection clipboard)
}

case "$1" in
	"") default ;;
	"-i") stdinpaste && echo -e "\n" ;;
	*) takearg "$@" ;;
esac
