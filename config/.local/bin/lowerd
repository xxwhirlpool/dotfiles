#!/usr/bin/env bash

usage() {
	echo "usage: $(basename "$0") [TEXT]"
	echo "options: -i (input text) | -h (print usage & exit)"
}

default() {
	tr '[:upper:]' '[:lower:]' | tr -d "\n" | tee >(xclip -selection clipboard) && echo -e "\n"
}

takearg() {
	echo "$@" | default
}

stdinpaste() {
	gum write --header="paste text here" | tr '[:upper:]' '[:lower:]' | tr -d "\n" | batcat --paging=never | tee >(xclip -selection clipboard) && echo -e "\n"
}

case "$1" in
	"") default ;;
	"-i") stdinpaste ;;
	"-h") usage ;;
	*) takearg "$@" ;;
esac
