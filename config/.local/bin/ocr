#!/usr/bin/env bash

# if no args given, or the img file doesn't exist,
# print this and exit
if [[ "$#" -eq 0 || ! -f "$1" ]]; then
	echo "usage: $(basename "$0") [IMAGE]"
	exit 1
fi

# check for tesseract dep
if [[ ! $(command -v tesseract) ]]; then
	echo "missing required dep: tesseract"
	exit 1
fi

# img is first arg
img="$1"

# do the ocr
tesseract --dpi 254 "$img" stdout
