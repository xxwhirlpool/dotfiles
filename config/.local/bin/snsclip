#!/usr/bin/env bash
#
# yt-dlp wrapper for quickly making clips
# to share on social media
#
# usage:
# snsclip YT_LINK "desired title of output file"

URL="$1"
FILE_OUT_NAME="$2"

if [ $# -eq 0 ]; then
	echo "Usage: snsclip [URL] [FILENAME]"
	exit 1
fi

# best audio + best video under 1080p (excl. AI upscale) && incl. file extension in output
yt-dlp -f "ba+bv*[height<=1080p][format_id!*=-sr]" -o "$FILE_OUT_NAME.%(ext)s" "$URL" --merge-output-format mp4
