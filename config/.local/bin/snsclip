#!/usr/bin/env bash
#
# yt-dlp wrapper for quickly making clips
# to share on social media
#
# usage:
# snsclip YT_LINK "desired title of output file"

URL="$1"
FILE_OUT_NAME="$2"

# if no args or <2 args (needs 2),
# print usage & exit
if [[ "$#" -eq 0 || "$#" -ne 2 ]]; then
	echo "usage: $(basename "$0") [URL] [FILENAME]"
	exit 1
fi

# best audio + best video under 1080p && incl. file extension in output
yt-dlp -f "ba+bv*[height<=1080p]" -o "$FILE_OUT_NAME.%(ext)s" "$URL" --merge-output-format mp4
