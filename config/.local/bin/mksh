#!/usr/bin/env bash

if [[ $# -eq 0 || $1 == "-b" && $# -ne 2 ]]; then
	echo "Usage: mksh [-b] [FILENAME]"
	echo "       -b puts it in PATH"
	echo "       else default to pwd"
	exit 1
fi

cmd="$1"
localpath="/home/kat/dotfiles/config/.local/bin"

default() {
	echo -e "#!/usr/bin/env bash\n" > "$cmd"
	chmod u+x "$cmd"
}

openfile() {
	mv "$cmd" "$localpath" && "$EDITOR" "$localpath/$cmd"
}

case "$1" in
	"-b") cmd="$2"; default "$@" && openfile "$@";;
	*) default "$@" && "$EDITOR" "$cmd";;
esac
