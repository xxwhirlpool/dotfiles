#!/usr/bin/env bash
#
# script to detect weasel words in a file
#
# inspired by the below blog post:
# https://matt.might.net/articles/shell-scripts-for-passive-voice-weasel-words-duplicates/

# vars
weasel_word_dir="$HOME/.config/wordfiles"
weasel_word_file="$weasel_word_dir/weasel"

# basic functions
usage_help() {
	echo "Usage: weasel [FILE]"
	exit 1
}

gum_echo() {
	gum style --foreground "#f4b8e4" "$@"
}

die() {
    printf "%s\n" "$1"
    exit 1
}

# check if word file exists
wordfile_check() {
	[[ -f "$weasel_word_file" ]] || die "weasel word file does not exist"
}

# cat the word file into a var
words=$(wordfile_check && cat "$weasel_word_file")

# print help if no args
if [[ "$#" -eq 0 ]]; then
	usage_help
fi

# do the thing
gum_echo "weasel words found:"
grep -E -i -n --color "\\b($words)\\b" "$*"
