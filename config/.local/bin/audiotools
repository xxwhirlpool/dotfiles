#!/usr/bin/env bash

flac2mp3() {
	for f in *.flac; do ffmpeg -i "$f" -ab 320k -map_metadata 0 -id3v2_version 3 "${f%.*}.mp3"; done
}

wav2mp3() {
	for f in *.wav; do ffmpeg -i "$f" -ab 320k -map_metadata 0 -id3v2_version 3 "${f%.*}.mp3"; done
}

choice() {
	choose=$(gum choose "flac2mp3" "wav2mp3")
	case "$choose" in
		*flac2mp3) flac2mp3 ;;
		*wav2mp3) wav2mp3 ;;
		*) exit 0;;
	esac
}

choice
