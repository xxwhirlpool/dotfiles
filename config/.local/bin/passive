#!/usr/bin/env bash
#
# script to detect passive voice in a file
#
# inspired by the below blog post:
# https://matt.might.net/articles/shell-scripts-for-passive-voice-weasel-words-duplicates/

# vars
passive_word_dir="$HOME/.config/wordfiles"
passive_word_file="$passive_word_dir/passive"

# basic functions
usage_help() {
	echo "Usage: passive [FILE]"
	exit 1
}

gum_echo() {
	gum style --foreground "#f4b8e4" "$@"
}

die() {
    printf "%s\n" "$1"
    exit 1
}

# check if word file exists
wordfile_check() {
	[[ -f "$passive_word_file" ]] || die "passive word file does not exist"
}

# cat the word file into a var
words=$(wordfile_check && cat "$passive_word_file")

# print help if no args
if [[ "$#" -eq 0 ]]; then
	usage_help
fi

# do the thing
gum_echo "weasel words found:"
grep -E -n -i --color "\\b(am|are|were|being|is|been|was|be)\ \\b[ ]*(\w+ed|($words))\\b" "$*"
