#!/usr/bin/env bash
#
# script to detect passive voice in a file
#
# inspired by the below blog post:
# https://matt.might.net/articles/shell-scripts-for-passive-voice-weasel-words-duplicates/

# vars
passive_worddir="$HOME/.config/wordfiles"
passive_wordfile="$passive_worddir/passive"

# basic functions
usage_help() {
	echo "Usage: passive [OPTIONS]"
	echo "Options: -f | -h"
}

gum_echo() {
	gum style --foreground "#f4b8e4" "$@"
}

die() {
    printf "%s\n" "$1"
    exit 1
}

# check if word file exists
wordfile_check() {
	[[ -f "$passive_wordfile" ]] || die "passive word file does not exist"
}

# cat the word file into a var
words=$(wordfile_check && cat "$passive_wordfile")

# do the thing; two options
# "": stdinpaste
# -f: read from file
readfile() {
	inputfile=$(gum file) || die "no file supplied"
	gum_echo "passive voice found:"
	grep -E -n -i --color "\\b(am|are|were|being|is|been|was|be)\ \\b[ ]*(\w+ed|($words))\\b" "$inputfile"
}

stdinpaste() {
	inputtext=$(gum write --header "paste text here") || die "no text supplied"
	gum_echo "passive voice found:"
	echo "$inputtext" | grep -E -n -i --color "\\b(am|are|were|being|is|been|was|be)\ \\b[ ]*(\w+ed|($words))\\b"
}

# run script
case "$1" in
	"") stdinpaste;;
	"-f") readfile;;
	"-h") usage_help;;
esac
