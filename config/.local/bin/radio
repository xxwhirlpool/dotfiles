#!/usr/bin/env bash

# stream URLs

declare -A stations=(
	["KEXP"]="https://raw.githubusercontent.com/mikepierce/internet-radio-streams/refs/heads/main/KEXP-Seattle.m3u"
	["NTS1"]="https://stream-relay-geo.ntslive.net/stream"
	["NTS2"]="https://stream-relay-geo.ntslive.net/stream2"
	["indiebeat-pop"]="https://azura.theindiebeat.fm/listen/the_indie_beat_radio_pop/radio.mp3"
	["indiebeat-rock"]="https://azura.theindiebeat.fm/listen/the_indie_beat_radio_-_rock/radio.mp3"
	["indiebeat-jazz"]="https://azura.theindiebeat.fm/listen/the_indie_beat_radio_-_jazz/radio.mp3"
	["indiebeat-electronic"]="https://azura.theindiebeat.fm/listen/the_indie_beat_radio_-_electronic/radio.mp3"
	["indiebeat-bonkwave"]="https://azura.theindiebeat.fm/listen/not_what_i_call_radio_bonk_wave/radio.mp3"
	["dadradio"]="http://stacey-campbell.com:8001/dadradio.mp3"
	["vintageobscura"]="https://radio.vintageobscura.net/stream"
)

# little header text graphic to show before playback

gum_echo() {
	top=$(gum style --bold --foreground "#a6d189" --border none --width 20 --margin "1 0" --align center "♥ NOW PLAYING ♥")
	bottom=$(gum style --foreground "#f4b8e4" --border none --width 20 --margin "1 0" --align center "$@")

	joingum=$(gum join --vertical --align center "$top" "$bottom")
	all=$(gum style --border-foreground "#99d1db" --border double --width 50 --padding "0 0" --align center "$joingum")

	gum join --vertical "$all"
}

# run the script

choice() {
	choose=$(gum choose  --header "radio stations" "kexp" "nts1" "nts2" "dadradio" "indiebeat-pop" "indiebeat-rock" "indiebeat-jazz" "vintageobscura")
	case "$choose" in
		kexp) gum_echo "KEXP" && mpv "${stations['KEXP']}";;
		nts1) gum_echo "NTS1" && mpv "${stations['NTS1']}";;
		nts2) gum_echo "NTS2" && mpv "${stations['NTS2']}";;
		dadradio) gum_echo "dadradio" && mpv "${stations['dadradio']}";;
		indiebeat-pop) gum_echo "indiebeat - pop" && mpv "${stations['indiebeat-pop']}";;
		indiebeat-rock) gum_echo "indiebeat - rock" && mpv "${stations['indiebeat-rock']}";;
		indiebeat-jazz) gum_echo "indiebeat - jazz" && mpv "${stations['indiebeat-jazz']}";;
		indiebeat-electronic) gum_echo "indiebeat - electronic" && mpv "${stations['indiebeat-electronic']}";;
		indiebeat-bonkwave) gum_echo "indiebeat -  bonkwave" && mpv "${stations['indiebeat-bonkwave']}";;
		vintageobscura) gum_echo "vintage obscura" && mpv "${stations['vintageobscura']}";;
	esac
}

choice
