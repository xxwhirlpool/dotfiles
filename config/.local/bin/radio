#!/usr/bin/env bash

# stream URLs

declare -A stations=(
	["KEXP"]="https://raw.githubusercontent.com/mikepierce/internet-radio-streams/refs/heads/main/KEXP-Seattle.m3u"
	["NTS1"]="https://stream-relay-geo.ntslive.net/stream"
	["NTS2"]="https://stream-relay-geo.ntslive.net/stream2"
	["indiebeat-pop"]="https://azura.theindiebeat.fm/listen/the_indie_beat_radio_pop/radio.mp3"
	["indiebeat-rock"]="https://azura.theindiebeat.fm/listen/the_indie_beat_radio_-_rock/radio.mp3"
	["indiebeat-jazz"]="https://azura.theindiebeat.fm/listen/the_indie_beat_radio_-_jazz/radio.mp3"
	["indiebeat-electronic"]="https://azura.theindiebeat.fm/listen/the_indie_beat_radio_-_electronic/radio.mp3"
	["indiebeat-bonkwave"]="https://azura.theindiebeat.fm/listen/not_what_i_call_radio_bonk_wave/radio.mp3"
	["dadradio"]="http://stacey-campbell.com:8001/dadradio.mp3"
	["vintageobscura"]="https://radio.vintageobscura.net/stream"
	["hbr1-tranceponder"]="https://www.hbr1.com/playlist/trance.ogg.m3u" # full-on/psychedelic
	["hbr1-tronic"]="https://www.hbr1.com/playlist/tronic.ogg.m3u" # minimal/tech
	["hbr1-dream"]="https://www.hbr1.com/playlist/ambient.ogg.m3u" # chillout
)

# little header text graphic to show before playback

gum_echo_custom() {
	top=$(gum style --bold --foreground "#a6d189" --border none --width 50 --margin "1 0" --align center "♥ NOW PLAYING ♥")
	bottom=$(gum style --foreground "#f4b8e4" --border none --width 50 --margin "1 0" --align center "$@")

	joingum=$(gum join --vertical --align center "$top" "$bottom")
	all=$(gum style --border-foreground "#99d1db" --border double --width 50 --padding "0 0" --align center "$joingum")

	gum join --vertical "$all"
}

# run the script

choice() {
	choose=$(gum choose --height 20 --header "radio stations" "kexp" "nts1" "nts2" "dadradio" "indiebeat-pop" "indiebeat-rock" "indiebeat-jazz" "vintageobscura" "hbr1-tranceponder" "hbr1-tronic" "hbr1-dream")
	case "$choose" in
		kexp) gum_echo_custom "KEXP" && mpv "${stations['KEXP']}";;
		nts1) gum_echo_custom "NTS1" && mpv "${stations['NTS1']}";;
		nts2) gum_echo_custom "NTS2" && mpv "${stations['NTS2']}";;
		dadradio) gum_echo_custom "dadradio" && mpv "${stations['dadradio']}";;
		indiebeat-pop) gum_echo_custom "indiebeat - pop" && mpv "${stations['indiebeat-pop']}";;
		indiebeat-rock) gum_echo_custom "indiebeat - rock" && mpv "${stations['indiebeat-rock']}";;
		indiebeat-jazz) gum_echo_custom "indiebeat - jazz" && mpv "${stations['indiebeat-jazz']}";;
		indiebeat-electronic) gum_echo_custom "indiebeat - electronic" && mpv "${stations['indiebeat-electronic']}";;
		indiebeat-bonkwave) gum_echo_custom "indiebeat -  bonkwave" && mpv "${stations['indiebeat-bonkwave']}";;
		vintageobscura) gum_echo_custom "vintage obscura" && mpv "${stations['vintageobscura']}";;
		hbr1-tranceponder) gum_echo_custom "HBR1 I.D.M. tranceponder" && mpv "${stations['hbr1-tranceponder']}";;
		hbr1-tronic) gum_echo_custom "HBR1 tronic lounge" && mpv "${stations['hbr1-tronic']}";;
		hbr1-dream) gum_echo_custom "HBR1 dream factory" && mpv "${stations['hbr1-dream']}"
	esac
}

choice
