#!/usr/bin/env bash
#
# convert markdown to HTML
# can read from STDIN or file
#
# this is a *very* opinionated script, using:
# gum, bat, perl, openssl, and xclip
# pandoc is mandatory!!!
# edit to suit your system

# functions
fromstdin() {
	# declare some vars
	MDFILE=$(mktemp --suffix .md)
	HTMLFILE="${MDFILE%.*}.html"
	HTMLFILE_FINAL="${HTMLFILE%.*}_final.html"
	# prompt user to paste markdown formatted text, then write it to a temp file
	gum write --header="paste MD-formatted text below" > "$MDFILE"
	# the conversion!
	pandoc --no-highlight --wrap=none "$MDFILE" -o "$HTMLFILE"
	# swap unicode/HTML entities to their actual characters
	perl -C -MHTML::Entities -pe 'decode_entities($_);' < "$HTMLFILE" > "$HTMLFILE_FINAL"
	# show final file
	batcat --paging=never "$HTMLFILE_FINAL"
	# copy file to clipboard too
	xclip -sel clip "$HTMLFILE_FINAL"
	# cleanup
	rm "$HTMLFILE"
}

fromfile() {
	# declare some vars
	MDFILE=$(gum file)
	HTMLFILE="${MDFILE%.*}.html"
	HTMLFILE_FINAL="${HTMLFILE%.*}_final.html"
	# the conversion!
	pandoc --no-highlight --wrap=none "$MDFILE" -o "$HTMLFILE"
	# swap unicode/HTML entities to their actual characters
	perl -C -MHTML::Entities -pe 'decode_entities($_);' < "$HTMLFILE" > "$HTMLFILE_FINAL"
	# show final file
	batcat --paging=never "$HTMLFILE_FINAL"
	# copy file to clipboard too
	xclip -sel clip "$HTMLFILE_FINAL"
	# cleanup
	rm "$HTMLFILE"
}

# execute it
choice() {
	choose=$(gum choose "paste" "file")
	case "$choose" in
		*paste) fromstdin ;;
		*file) fromfile ;;
		*) exit ;;
	esac
}

choice
