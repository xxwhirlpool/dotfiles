#!/usr/bin/env bash

cropcenter() {
	imgfile=$(gum file ./)
	ext="${imgfile##*.}"
	newname="${imgfile%.*}_new".$ext
	magick "$imgfile" -gravity center -crop 1:1 +repage "$newname"
}

choice() {
    choose=$(gum choose "cropcenter")
    case "$choose" in
        cropcenter) cropcenter ;;
        *) exit;;
    esac
}

choice
