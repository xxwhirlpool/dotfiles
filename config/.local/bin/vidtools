#!/bin/bash

avi2mkv() {
	for f in *.avi; do ffmpeg -fflags +genpts -i "$f" -c:v copy -c:a copy -c:s copy "${f%.*} AVI2MKV.mkv" || break; done
}

any2hevc() {
	for f in *.mkv; do ffmpeg -hwaccel cuda -hwaccel_output_format cuda -i "$f" -c:v hevc_nvenc -qmin 24 -qmax 24 -vtag hvc1 -profile main -preset slow -rc vbr_hq -c:a copy -c:s copy -map 0 "${f%.*} HEVC.mkv" || break; done
}

vid2frames() {
	for f in *.mp4; do ffmpeg -i "$f" '%04d.png' || break; done
}

vidsubs() {
	for f in *.mkv; do mkvmerge -o "${f%.*} SUB.mkv" "$f" --language 0:eng "${f%.*}.srt" || break; done
}

vidhash() {
	# borrowed from my buddy neckspike:
	# https://pastebin.com/mg3CVDiU
	for f in *.mkv; do hash=$(crc32 "$f") ext="${f##*.}" newname="${f%.*} [$hash]".$ext && gum confirm "are you sure you want to rename?" && mv "$f" "$newname" || echo "printing names instead" && echo "$newname"; done
}

choice() {
	choose=$(gum choose "avi2mkv" "any2hevc" "vid2frames" "vidsubs" "vidhash")
	case "$choose" in
		*avi2mkv) avi2mkv ;;
		*any2hevc) any2hevc ;;
		*vid2frames) vid2frames ;;
		*vidsubs) vidsubs ;;
		*vidhash) vidhash ;;
		*) exit;;
	esac
}

choice
