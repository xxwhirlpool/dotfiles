#!/usr/bin/env bash

avi2mkv() {
	for f in *.avi; do ffmpeg -fflags +genpts -i "$f" -c:v copy -c:a copy -c:s copy "${f%.*} AVI2MKV.mkv" || break; done
}

any2hevc() {
	shopt -s nullglob
	for f in *.{mkv,mp4,ts}; do ffmpeg -hwaccel cuda -hwaccel_output_format cuda -i "$f" -c:v hevc_nvenc -qmin 24 -qmax 24 -vtag hvc1 -profile main -preset slow -rc vbr_hq -c:a copy -c:s copy -map 0 "${f%.*} HEVC.mkv" || break; done
}

vid2frames() {
	shopt -s nullglob
	for f in *.{mkv,mp4,webm}; do ffmpeg -i "$f" -vf mpdecimate,setpts=N/FRAME_RATE/TB "%04d.png" || break; done
}

vidsubs() {
	shopt -s nullglob
	for f in *.{mkv,mp4}; do mkvmerge -o "${f%.*} SUB.mkv" "$f" --language 0:eng "${f%.*}.srt" || break; done
}

vidhash() {
	# borrowed from my buddy neckspike:
	# https://pastebin.com/mg3CVDiU
	for f in *.mkv; do
		hash=$(crc32 "$f" | tr '[:lower:]' '[:upper:]')
		ext="${f##*.}"
		newname="${f%.*} [$hash]".$ext

		gum confirm "are you sure you want to rename?" --default=yes --timeout=2s && mv "$f" "$newname" && echo -e "new name: $newname" || echo -e "no files renamed: $newname"
	done
}

choice() {
	choose=$(gum choose "avi2mkv" "any2hevc" "vid2frames" "vidsubs" "vidhash")
	case "$choose" in
		*avi2mkv) avi2mkv ;;
		*any2hevc) any2hevc ;;
		*vid2frames) vid2frames ;;
		*vidsubs) vidsubs ;;
		*vidhash) vidhash ;;
		*) exit;;
	esac
}

choice
