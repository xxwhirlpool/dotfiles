#!/usr/bin/env bash

tempfile=$(mktemp --suffix .md)

logic() {
	gum write --header "paste text here" > "$tempfile"
	if [[ -f "$tempfile" ]]; then
		while read -r "ln"; do
			if [[ ! "$ln" == "" ]]; then
				echo "> $ln"
			else
				echo ""
			fi
		done < "$tempfile"
		rm "$tempfile"
	else
		echo "Usage: mdquote [PASTE TEXT]"
		exit 1
	fi
}

logic | perl -pe "chomp if eof" | tee >(xclip -selection clipboard)
