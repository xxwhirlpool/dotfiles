#!/usr/bin/env bash

play_cmd_args=(
	"-q"
)


sfx_path="/home/kat/dotfiles/misc/sounds"

tunes=(
	"bad" # 1
	"chime" # 2
	"ding" # 3
	"tada" # 4
	"twinkle" # 5
)

for ((i=0, v=1; i < "${#tunes[@]}"; i++, v++ )); do
	declare "sfx$v"="$sfx_path/${tunes[$i]}"
done

case "$1" in
	"bad") aplay "${play_cmd_args[*]}" "$sfx1";;
	"chime") aplay "${play_cmd_args[*]}" "$sfx2";;
	"ding") aplay "${play_cmd_args[*]}" "$sfx3";;
	"tada") aplay "${play_cmd_args[*]}" "$sfx4";;
	"twinkle") aplay "${play_cmd_args[*]}" "$sfx5";;
esac
