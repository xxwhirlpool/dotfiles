#!/bin/bash

notif() {
	notify-send "$time timer done!"
	aplay -q /usr/share/sounds/sound-icons/start
	spd-say -t female3 -r +25 "timer done!"
}

if [[ ! "$1" =~ "m" ]]; then
	echo "add a time or a time unit (m for minutes)"
else
	time="$1"
	echo -e "$time: 🌈✩₊˚.⋆⋆⁺₊✧🦋"  | lolcat -p 0.2
	timer "$time" && notif || exit 1
fi
