[general]
status_path = "~/.config/vdirsyncer/status/"

[pair katcontacts]
a = "katcontacts_local"
b = "katcontacts_remote"
collections = ["from a", "from b"]

metadata = ["displayname"]

[storage katcontacts_local]
type = "filesystem"
path = "~/.config/vdirsyncer/contacts"
fileext = ".vcf"

[storage katcontacts_remote]
type = "carddav"
url = "https://calendar.girlonthemoon.xyz/springpool/52ad2c31-65bb-a4c7-23c7-beac8c3f48e8/"
username = "springpool"
password.fetch = ["command", "cat", "~/.vcardpass"]

[storage katcal_local]
type = "filesystem"
path = "~/.config/vdirsyncer/calendar"
fileext = ".ics"

[storage katcal_remote]
type = "http"
url = "https://calendar.girlonthemoon.xyz/springpool/9f677c31-9924-4a76-8763-73fd3025acdb/"
read_only = "false"
