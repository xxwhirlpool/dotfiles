[default]

default_calendar = kat
highlight_event_days = true

[view]
dynamic_days = false

[locale]
unicode_symbols = false
local_timezone = America/New_York
default_timezone = America/New_York
timeformat = %I:%m
dateformat = %A
longdateformat = %Y-%m-%d

[calendars]

[[kat]]
path = ~/.config/vdirsyncer/calendars/kat/

[[rockness]]
path = ~/.config/vdirsyncer/calendar_rockness/
