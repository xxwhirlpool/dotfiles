######################################
# functions
######################################

cdmess() {
	# from this blog post:
	# https://blog.larah.me/mess-directory/
    today_tmpdir="${TMPDIR-/tmp}/${USER}_mess/$(date +%F)"
    mkdir -p "$today_tmpdir"
    cd "$(mktemp -d -p "${today_tmpdir}" XXXX)" || exit 1
}
 
# get a random free port. this is useful for my
# insane sysadmin website woman adventures
portfree() {
	while
		port=$(shuf -n 1 -i 1024-65535)
		netstat -atun | grep -q "$port"
	do
		continue
	done
	echo "$port"
}
 
# print internal & external IPs
whatip() {
	# internal
	echo -n "internal IP: " | lolcat -p 0.7
	hostname -I | awk '{print $1}'

	# external
	echo -n "external IP: " | lolcat -p 0.7
	curl -4 icanhazip.com
}
 
# password generator. takes input for password length by number
passgen() {
	PASSLENGTH=$(gum input --placeholder "type a number")
	date +%s | sha256sum | base64 | head -c "$PASSLENGTH"; echo
}

# display random ASCII art from
# custom dir of art in dotfiles
# using arttime (github: poetaman/arttime)
playart() {
	ARTDIR="/home/kat/dotfiles/config/.local/share/arttime/textart"
	ARTSHUF=$(find "$ARTDIR" -type f | shuf -n1)

	for art in $ARTSHUF; do
		arttime --nolearn -a "$art" --ac 5
	done
}

# to get quick notifs
# after long commands
notif() {
	notify-send "done!"
	sfx chime
	spd-say -t female3 -r +25 "done!"
}

# shamelessly stolen from evan hahn:
# https://evanhahn.com/scripts-i-wrote-that-i-use-all-the-time/#audio-and-video-and-pictures
boop() {
	local last="$?"
	if [[ "$last" == "0" ]]; then
		sfx chime
	else
		sfx bad
	fi
	exit "$last"
}

# make & cd into a folder
mkcd() {
  mkdir -p "$@" && cd "$_" || exit 1;
}

# man by default, fall back to `help`
# for shell functions
# https://lobste.rs/s/fkr3ha/some_terminal_frustrations#c_70wike
man() {
	/usr/bin/man "$@" || help "$@" | less
}

# https://askubuntu.com/questions/196890/how-to-find-the-bitrate-of-an-mp3-file-via-command-line
bitrate() {
	gum style --foreground "#f4b8e4" "file: " | tr -d "\n"
	basename "$1"
	gum style --foreground "#f4b8e4" "bitrate: " | tr -d "\n"
	echo "$(file "$1" | sed 's/.*, \(.*\)kbps.*/\1/' | tr -d " " )" kbps
}

