{
	"schemaVersion": "0.1.0",
	"name": "Leaflet",
	"behavior": "create",
	"noteContentFormat": "{{selectorHtml:.postContent|markdown}}",
	"properties": [
		{
			"name": "created",
			"value": "{{time|date:\\\"YYYY-MM-DDTHH:mm:ssZ\\\"}}",
			"type": "date"
		},
		{
			"name": "url",
			"value": "{{url}}",
			"type": "multitext"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{selectorHtml:.postInfo>div>button span|first|markdown}}",
			"type": "multitext"
		},
		{
			"name": "published",
			"value": "{{published|date:\\\"YYYY-MM-DD\\\"}}",
			"type": "date"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "clippings-articles",
			"type": "multitext"
		}
	],
	"triggers": [
		"leaflet.pub"
	],
	"noteNameFormat": "{{title}}",
	"path": "clippings/articles"
}