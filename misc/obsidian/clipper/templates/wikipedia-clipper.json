{
	"schemaVersion": "0.1.0",
	"name": "Wikipedia",
	"behavior": "create",
	"noteContentFormat": "{{selectorHtml:#mw-content-text|remove_html:(\".navbox,.printfooter,.side-box,.infobox-image,.mw-editsection\")|markdown}}",
	"properties": [
		{
			"name": "url",
			"value": "{{url}}",
			"type": "multitext"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "clippings-wikipedia",
			"type": "multitext"
		},
		{
			"name": "created",
			"value": "{{date|date:\\\"YYYY-MM-DD\\\"}}",
			"type": "date"
		}
	],
	"triggers": [
		"https://en.wikipedia.org"
	],
	"noteNameFormat": "{{title}}",
	"path": "clippings/wikipedia"
}