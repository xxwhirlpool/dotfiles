{
	"schemaVersion": "0.1.0",
	"name": "fullHtml",
	"behavior": "create",
	"noteContentFormat": "{{fullHtml|markdown}}",
	"properties": [
		{
			"name": "created",
			"value": "{{time|date:\\\"YYYY-MM-DDTHH:mm:ssZ\\\"}}",
			"type": "date"
		},
		{
			"name": "url",
			"value": "{{url}}",
			"type": "multitext"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{author|split:\\\",\\\"|join}}",
			"type": "multitext"
		},
		{
			"name": "published",
			"value": "{{published|date:\\\"YYYY-MM-DD\\\"}}",
			"type": "date"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "clippings-articles",
			"type": "multitext"
		}
	],
	"triggers": [],
	"noteNameFormat": "{{title|safe_name}}",
	"path": "clippings/articles"
}